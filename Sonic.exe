--1.0
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 360)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.Visible = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

if isMobile then
	frame.AnchorPoint = Vector2.new(0.5, 0.6)
	local function updateScaleAndPosition()
		local viewport = workspace.CurrentCamera.ViewportSize
		local scaleFactor = math.min(1, viewport.X / 400, viewport.Y / 500)
		local scale = frame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		scale.Scale = scaleFactor
		scale.Parent = frame
		frame.Position = UDim2.new(0.5, 0, 0.5, 0)
	end
	updateScaleAndPosition()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScaleAndPosition)
else
	frame.AnchorPoint = Vector2.new(0, 0)
	frame.Position = UDim2.new(0.5, -150, 0.5, -200)
end

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Text = "TD Definitive Edition UI script"
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.TextColor3 = Color3.new(1, 1, 1)
title.Parent = frame

local tabsFrame = Instance.new("Frame")
tabsFrame.Size = UDim2.new(1, 0, 0, 35)
tabsFrame.Position = UDim2.new(0, 0, 0, 40)
tabsFrame.BackgroundTransparency = 1
tabsFrame.Parent = frame

local padding = Instance.new("UIPadding")
padding.PaddingLeft = UDim.new(0, 6)
padding.PaddingRight = UDim.new(0, 6)
padding.PaddingTop = UDim.new(0, 4)
padding.PaddingBottom = UDim.new(0, 4)
padding.Parent = tabsFrame

local mainTab = Instance.new("TextButton")
mainTab.Size = UDim2.new(1, 0, 1, 0)
mainTab.Text = "Main"
mainTab.Font = Enum.Font.GothamBold
mainTab.TextSize = 16
mainTab.TextColor3 = Color3.new(1, 1, 1)
mainTab.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
mainTab.Parent = tabsFrame
Instance.new("UICorner", mainTab).CornerRadius = UDim.new(0, 8)

local content = Instance.new("ScrollingFrame")
content.Size = UDim2.new(1, 0, 1, -100)
content.Position = UDim2.new(0, 0, 0, 83)
content.BackgroundTransparency = 1
content.ScrollBarThickness = 10
content.ScrollBarImageTransparency = 1
content.CanvasSize = UDim2.new(0, 0, 0, 0)
content.AutomaticCanvasSize = Enum.AutomaticSize.Y
content.Parent = frame

local contentPadding = Instance.new("UIPadding")
contentPadding.PaddingTop = UDim.new(0, 6)
contentPadding.PaddingBottom = UDim.new(0, 12)
contentPadding.PaddingLeft = UDim.new(0, 6)
contentPadding.PaddingRight = UDim.new(0, 6)
contentPadding.Parent = content

local layout = Instance.new("UIListLayout")
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Padding = UDim.new(0, 6)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Parent = content

local opened = true
local function toggleUI()
	local target
	if opened then
		if isMobile then
			local viewport = workspace.CurrentCamera.ViewportSize
			target = UDim2.new(0.5, 0, 0.5, viewport.Y/2 + frame.AbsoluteSize.Y * 0.4 + 150)
		else
			target = UDim2.new(0.5, -150, 1, 50)
		end
	else
		if isMobile then
			target = UDim2.new(0.5, 0, 0.5, 0)
		else
			target = UDim2.new(0.5, -150, 0.5, -200)
		end
	end
	opened = not opened
	TweenService:Create(frame,TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),{Position = target}):Play()
end

if isMobile then
	local openBtn = Instance.new("TextButton")
	openBtn.Size = UDim2.new(0, 52, 0, 52)
	openBtn.Position = UDim2.new(1, -70, 0.5, -26)
	openBtn.Text = "UI"
	openBtn.Font = Enum.Font.GothamBold
	openBtn.TextSize = 16
	openBtn.TextColor3 = Color3.new(1, 1, 1)
	openBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	openBtn.Parent = gui
	Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1, 0)
	openBtn.MouseButton1Click:Connect(toggleUI)
end

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if not isMobile and input.KeyCode == Enum.KeyCode.Y then
		toggleUI()
	end
end)

local function makeButton(name)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.95,0,0,38)
	btn.Text = name
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 14
	btn.TextColor3 = Color3.new(1,1,1)
	btn.BackgroundColor3 = Color3.fromRGB(60,60,60)
	btn.Parent = content
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0,8)
	return btn
end

local btn1 = makeButton("Hitbox Expander (Gui)")
local btn2 = makeButton("Highlights")
local btn3 = makeButton("Jump no cd")
local btn4 = makeButton("LMS 1.4")
local btn5 = makeButton("Walkspeed 40")

btn1.MouseButton1Click:Connect(function()
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")

    local localPlayer = Players.LocalPlayer
    local playerGui = localPlayer:WaitForChild("PlayerGui")

    local selectedPlayer = nil
    local selectedButton = nil
    local transparencyOn = false
    local canCollideOn = false
    local guiOpen = true

    local playerButtons = {}

    local function findCollisionPart(plr)
        local character = plr.Character
        if not character then
            return nil
        end

        local root = character:FindFirstChild("torso") or character:FindFirstChild("HumanoidRootPart")
        if not root then
            return nil
        end

        local col = root:FindFirstChild("collision")
        if col and col:IsA("BasePart") then
            return col
        end

        return nil
    end

    local function setCollisionTransparency(plr, enabled)
        if plr == localPlayer then
            return
        end

        local col = findCollisionPart(plr)
        if col then
            col.Transparency = enabled and 0.8 or 1
        end
    end

    local function applyTransparencyToAll()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= localPlayer then
                setCollisionTransparency(plr, transparencyOn)
            end
        end
    end

    local function setCollisionForPlayer(plr, sizeNumber)
        if plr == localPlayer then
            return
        end

        local col = findCollisionPart(plr)
        if not col then
            return
        end

        if sizeNumber then
            col.Size = Vector3.new(sizeNumber, sizeNumber, sizeNumber)
        end
        col.CanCollide = canCollideOn
    end

    local function setCollisionForAll(sizeNumber)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= localPlayer then
                setCollisionForPlayer(plr, sizeNumber)
            end
        end
    end

    local function parseSize(text)
        local n = tonumber(text)
        if not n then
            return nil
        end
        if n <= 0 then
            return nil
        end
        return n
    end

    local function deselectCurrent()
        if selectedButton then
            selectedButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        end
        selectedButton = nil
        selectedPlayer = nil
    end

    local function selectPlayer(plr, btn)
        if selectedButton then
            selectedButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        end
        selectedButton = btn
        selectedPlayer = plr
        btn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CollisionGUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.DisplayOrder = 999
    ScreenGui.Parent = playerGui

    local Main = Instance.new("Frame")
    Main.Parent = ScreenGui
    Main.Size = UDim2.new(0, 220, 0, 360)
    Main.Position = UDim2.new(0.5, -110, 0.5, -180)
    Main.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Main.BorderSizePixel = 0
    Main.Visible = guiOpen

    local Title = Instance.new("TextLabel")
    Title.Parent = Main
    Title.Size = UDim2.new(1, 0, 0, 35)
    Title.Text = "Collision Selector"
    Title.BackgroundTransparency = 1
    Title.TextColor3 = Color3.new(1, 1, 1)
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 20

    local List = Instance.new("ScrollingFrame")
    List.Parent = Main
    List.Position = UDim2.new(0, 10, 0, 45)
    List.Size = UDim2.new(1, -20, 0, 120)
    List.CanvasSize = UDim2.new(0, 0, 0, 0)
    List.ScrollBarImageTransparency = 0.3
    List.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    List.BorderSizePixel = 0

    local Layout = Instance.new("UIListLayout")
    Layout.Parent = List
    Layout.Padding = UDim.new(0, 5)
    Layout.SortOrder = Enum.SortOrder.Name

    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        List.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y)
    end)

    local SizeBox = Instance.new("TextBox")
    SizeBox.Parent = Main
    SizeBox.Position = UDim2.new(0, 10, 0, 175)
    SizeBox.Size = UDim2.new(1, -20, 0, 30)
    SizeBox.PlaceholderText = "Collision size (ej: 20)"
    SizeBox.Text = ""
    SizeBox.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    SizeBox.TextColor3 = Color3.new(1, 1, 1)
    SizeBox.BorderSizePixel = 0
    SizeBox.Font = Enum.Font.SourceSans
    SizeBox.TextSize = 16

    local Toggle = Instance.new("TextButton")
    Toggle.Parent = Main
    Toggle.Position = UDim2.new(0, 10, 0, 215)
    Toggle.Size = UDim2.new(1, -20, 0, 30)
    Toggle.Text = "Transparency: OFF"
    Toggle.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    Toggle.TextColor3 = Color3.new(1, 1, 1)
    Toggle.BorderSizePixel = 0
    Toggle.Font = Enum.Font.SourceSans
    Toggle.TextSize = 16

    local CollideToggle = Instance.new("TextButton")
    CollideToggle.Parent = Main
    CollideToggle.Position = UDim2.new(0, 0, 0, 250)
    CollideToggle.Size = UDim2.new(1, -20, 0, 30)
    CollideToggle.Text = "CanCollide: OFF"
    CollideToggle.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    CollideToggle.TextColor3 = Color3.new(1, 1, 1)
    CollideToggle.BorderSizePixel = 0
    CollideToggle.Font = Enum.Font.SourceSans
    CollideToggle.TextSize = 16

    local Apply = Instance.new("TextButton")
    Apply.Parent = Main
    Apply.Position = UDim2.new(0, 10, 0, 285)
    Apply.Size = UDim2.new(1, -20, 0, 35)
    Apply.Text = "APPLY SIZE"
    Apply.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
    Apply.TextColor3 = Color3.new(1, 1, 1)
    Apply.BorderSizePixel = 0
    Apply.Font = Enum.Font.SourceSansBold
    Apply.TextSize = 18

    local ApplyAll = Instance.new("TextButton")
    ApplyAll.Parent = Main
    ApplyAll.Position = UDim2.new(0, 10, 0, 325)
    ApplyAll.Size = UDim2.new(1, -20, 0, 35)
    ApplyAll.Text = "APLICAR A TODOS"
    ApplyAll.BackgroundColor3 = Color3.fromRGB(110, 110, 110)
    ApplyAll.TextColor3 = Color3.new(1, 1, 1)
    ApplyAll.BorderSizePixel = 0
    ApplyAll.Font = Enum.Font.SourceSansBold
    ApplyAll.TextSize = 18

    local MobileToggle = Instance.new("TextButton")
    MobileToggle.Parent = ScreenGui
    MobileToggle.Size = UDim2.new(0, 40, 0, 40)
    MobileToggle.Position = UDim2.new(1, -50, 0, 10)
    MobileToggle.Text = "☰"
    MobileToggle.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    MobileToggle.TextColor3 = Color3.new(1, 1, 1)
    MobileToggle.BorderSizePixel = 0
    MobileToggle.Font = Enum.Font.SourceSansBold
    MobileToggle.TextSize = 24
    MobileToggle.ZIndex = 10

    MobileToggle.MouseButton1Click:Connect(function()
        guiOpen = not guiOpen
        Main.Visible = guiOpen
    end)

    local function createPlayerButton(plr)
        if plr == localPlayer then
            return
        end

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 28)
        btn.Text = plr.Name
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 15
        btn.Parent = List

        btn.MouseButton1Click:Connect(function()
            selectPlayer(plr, btn)
        end)

        playerButtons[plr] = btn

        if transparencyOn then
            setCollisionTransparency(plr, true)
        end
    end

    local function removePlayerButton(plr)
        local btn = playerButtons[plr]
        if not btn then
            return
        end

        if selectedButton == btn then
            deselectCurrent()
        end

        playerButtons[plr] = nil
        btn:Destroy()
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        createPlayerButton(plr)
    end

    Players.PlayerAdded:Connect(createPlayerButton)
    Players.PlayerRemoving:Connect(removePlayerButton)

    Toggle.MouseButton1Click:Connect(function()
        transparencyOn = not transparencyOn
        Toggle.Text = "Transparency: " .. (transparencyOn and "ON" or "OFF")
        applyTransparencyToAll()
    end)

    CollideToggle.MouseButton1Click:Connect(function()
        canCollideOn = not canCollideOn
        CollideToggle.Text = "CanCollide: " .. (canCollideOn and "ON" or "OFF")
    end)

    Apply.MouseButton1Click:Connect(function()
        if not selectedPlayer then
            return
        end

        local sizeNumber = parseSize(SizeBox.Text)
        if not sizeNumber then
            return
        end

        setCollisionForPlayer(selectedPlayer, sizeNumber)
    end)

    ApplyAll.MouseButton1Click:Connect(function()
        local sizeNumber = parseSize(SizeBox.Text)
        if not sizeNumber then
            return
        end

        setCollisionForAll(sizeNumber)
    end)

    RunService.Heartbeat:Connect(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= localPlayer then
                setCollisionForPlayer(plr, nil)
            end
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then
            return
        end

        if input.KeyCode == Enum.KeyCode.T then
            guiOpen = not guiOpen
            Main.Visible = guiOpen
        elseif input.KeyCode == Enum.KeyCode.M then
            ScreenGui:Destroy()
        end
    end)
end)

btn2.MouseButton1Click:Connect(function()
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local LocalPlayer = Players.LocalPlayer

    local DISPLAY_FOLDER_NAME = "displayPlayers"
    local REFRESH_INTERVAL = 1

    local SHADOW_NAME = "shadow"
    local SHADOW_FILL = Color3.fromRGB(0, 0, 0)
    local SHADOW_OUTLINE = Color3.fromRGB(200, 200, 200)

    local CHARACTER_COLORS = {
        tails = Color3.fromRGB(255, 165, 0),
        knuckles = Color3.fromRGB(255, 0, 0),
        eggman = Color3.fromRGB(255, 255, 0),
        amy = Color3.fromRGB(255, 105, 180),
        cream = Color3.fromRGB(255, 218, 185),
        sally = Color3.fromRGB(210, 180, 140),
        charmy = Color3.fromRGB(210, 180, 140),
        shadow = Color3.fromRGB(0, 0, 0),
        rouge = Color3.fromRGB(255, 255, 255),
        blaze = Color3.fromRGB(237, 179, 255),
        espio = Color3.fromRGB(128, 0, 128),
        silver = Color3.fromRGB(192, 192, 192),
        sonic = Color3.fromRGB(0, 0, 255),
        metalsonic = Color3.fromRGB(0, 0, 155),
        kolossos = Color3.fromRGB(139, 0, 0),
        sonicexe = Color3.fromRGB(139, 0, 0),
        metalknuckles = Color3.fromRGB(181, 0, 0),
        vector = Color3.fromRGB(32, 197, 0),
        furnace = Color3.fromRGB(139, 0, 0),
        doll = Color3.fromRGB(139, 0, 0),
        tetanus = Color3.fromRGB(139, 0, 0),
        lordx = Color3.fromRGB(139, 0, 0),
        tailsdoll = Color3.fromRGB(139, 0, 0),
        nexus = Color3.fromRGB(139, 0, 0),
        fleetway = Color3.fromRGB(255, 242, 0),
    }

    local entries = {}

    local function normalize(v)
        if type(v) ~= "string" then
            return ""
        end
        return string.lower(v)
    end

    local function colorsFor(characterName)
        local base = CHARACTER_COLORS[characterName]
        if not base then
            return nil
        end
        if characterName == SHADOW_NAME then
            return SHADOW_FILL, SHADOW_OUTLINE
        end
        return base, base
    end

    local function isLocalModel(model)
        local char = LocalPlayer.Character
        return char ~= nil and model == char
    end

    local function cleanup(displayName)
        local entry = entries[displayName]
        if not entry then
            return
        end
        if entry.conn then
            entry.conn:Disconnect()
        end
        if entry.highlight then
            entry.highlight:Destroy()
        end
        entries[displayName] = nil
    end

    local function ensureHighlight(model, fill, outline)
        local h = Instance.new("Highlight")
        h.Adornee = model
        h.FillColor = fill
        h.OutlineColor = outline
        h.FillTransparency = 0.4
        h.OutlineTransparency = 0
        h.Enabled = true
        h.Parent = workspace
        return h
    end

    local function refreshESP()
        local displayFolder = ReplicatedStorage:FindFirstChild(DISPLAY_FOLDER_NAME)
        if not displayFolder then
            return
        end

        for displayName in pairs(entries) do
            if not displayFolder:FindFirstChild(displayName) then
                cleanup(displayName)
            end
        end

        for _, child in ipairs(displayFolder:GetChildren()) do
            local stats = child:FindFirstChild("stats")
            if not stats then
                continue
            end

            local charObj = stats:FindFirstChild("character")
            if not (charObj and charObj:IsA("StringValue")) then
                continue
            end

            local characterName = normalize(charObj.Value)
            local fill, outline = colorsFor(characterName)
            if not fill then
                continue
            end

            local model = workspace:FindFirstChild(child.Name)
            if not (model and model:IsA("Model")) then
                continue
            end

            if isLocalModel(model) then
                continue
            end

            local displayName = child.Name
            local entry = entries[displayName]

            if not entry or not entry.highlight or entry.highlight.Parent == nil then
                if entry then
                    cleanup(displayName)
                end

                local highlight = ensureHighlight(model, fill, outline)

                local conn = charObj.Changed:Connect(function()
                    local newName = normalize(charObj.Value)
                    local newFill, newOutline = colorsFor(newName)
                    if newFill and highlight.Parent ~= nil then
                        highlight.FillColor = newFill
                        highlight.OutlineColor = newOutline
                    end
                end)

                entries[displayName] = { highlight = highlight, conn = conn }
            else
                entry.highlight.Adornee = model
                entry.highlight.FillColor = fill
                entry.highlight.OutlineColor = outline
            end
        end
    end

    local displayFolder = ReplicatedStorage:WaitForChild(DISPLAY_FOLDER_NAME)
    displayFolder.ChildAdded:Connect(refreshESP)
    displayFolder.ChildRemoved:Connect(refreshESP)

    task.spawn(function()
        while task.wait(REFRESH_INTERVAL) do
            refreshESP()
        end
    end)

    refreshESP()
end)

btn3.MouseButton1Click:Connect(function()
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")

    local LocalPlayer = Players.LocalPlayer
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

    local JUMP_POWER = 60

    local isJumping = false
    local jumpThread = nil

    local humanoidConnections = {}
    local inputConnections = {}
    local guiConnections = {}

    local function disconnectAll(list)
        for _, c in ipairs(list) do
            if c then
                c:Disconnect()
            end
        end
        table.clear(list)
    end

    local function getHumanoid()
        local character = LocalPlayer.Character
        if not character then
            return nil
        end
        return character:FindFirstChildOfClass("Humanoid")
    end

    local function isGrounded(humanoid)
        if not humanoid then
            return false
        end

        local state = humanoid:GetState()
        return state == Enum.HumanoidStateType.Running
            or state == Enum.HumanoidStateType.RunningNoPhysics
            or state == Enum.HumanoidStateType.Landed
    end

    local function enforceJumpPower(humanoid)
        disconnectAll(humanoidConnections)

        if not humanoid then
            return
        end

        humanoid.JumpPower = JUMP_POWER

        table.insert(humanoidConnections, humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
            if humanoid.JumpPower ~= JUMP_POWER then
                humanoid.JumpPower = JUMP_POWER
            end
        end))
    end

    local function doJump()
        local humanoid = getHumanoid()
        if humanoid and isGrounded(humanoid) then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end

    local function startJumping()
        if isJumping then
            return
        end

        isJumping = true
        jumpThread = task.spawn(function()
            while isJumping do
                doJump()
                task.wait()
            end
        end)
    end

    local function stopJumping()
        isJumping = false
        jumpThread = nil
    end

    local function createJumpButton(parentFrame)
        local existing = parentFrame:FindFirstChild("JumpButton")
        if existing then
            existing:Destroy()
        end

        local button = Instance.new("ImageButton")
        button.Name = "JumpButton"
        button.Size = UDim2.new(0, 120, 0, 120)
        button.Position = UDim2.new(1, -150, 1, -150)
        button.BackgroundColor3 = Color3.new(0, 0, 0)
        button.AutoButtonColor = true
        button.Parent = parentFrame

        table.insert(guiConnections, button.MouseButton1Down:Connect(startJumping))
        table.insert(guiConnections, button.MouseButton1Up:Connect(stopJumping))

        return button
    end

    local function setupJumpButton()
        disconnectAll(guiConnections)

        local touchGui = PlayerGui:FindFirstChild("TouchGui")
        if not touchGui then
            return
        end

        local frame = touchGui:FindFirstChild("TouchControlFrame")
        if not frame then
            return
        end

        createJumpButton(frame)
    end

    local function bindInput()
        disconnectAll(inputConnections)

        table.insert(inputConnections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then
                return
            end
            if input.KeyCode == Enum.KeyCode.Space then
                startJumping()
            end
        end))

        table.insert(inputConnections, UserInputService.InputEnded:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.Space then
                stopJumping()
            end
        end))
    end

    local function onCharacterAdded(character)
        stopJumping()

        local humanoid = character:WaitForChild("Humanoid")
        enforceJumpPower(humanoid)
        setupJumpButton()
    end

    bindInput()
    LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

    if LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        enforceJumpPower(humanoid)
    end

    setupJumpButton()
end)

btn4.MouseButton1Click:Connect(function()
    do
        local env = (getgenv and getgenv()) or _G
        if env.__LMS_CUSTOM_MUSIC_V8__ then return end
        env.__LMS_CUSTOM_MUSIC_V8__ = true
    end

    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local SoundService      = game:GetService("SoundService")
    local Players           = game:GetService("Players")

    local LocalPlayer = Players.LocalPlayer
    local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

    local displayPlayers  = ReplicatedStorage:WaitForChild("displayPlayers")
    local mainSoundsGroup = SoundService:WaitForChild("mainSounds")
    local currentSound    = mainSoundsGroup:WaitForChild("current")

    do
        local gui = Instance.new("ScreenGui")
        gui.Name = "LMS_UI"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.Parent = PlayerGui

        local label = Instance.new("TextLabel")
        label.Name = "LMS_Label"
        label.Parent = gui
        label.Size = UDim2.new(0, 90, 0, 20)
        label.Position = UDim2.new(0, 10, 1, -20)
        label.BackgroundTransparency = 1
        label.Text = "LMS script v5"
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextScaled = true
        label.ZIndex = 9999
    end

    local IGNORED = {
        sonicexe=true, kolossos=true, tailsdoll=true, nexus=true,
        lordx=true, fleetway=true, tetanus=true, doll=true,
    }

    local TAKEN = {
        tails=true, knuckles=true, eggman=true, amy=true, cream=true, sally=true,
        shadow=true, rouge=true, blaze=true, silver=true, sonic=true, supersonic=true,
        metalsonic=true, metalknuckles=true, vector=true, charmy=true, espio=true,
    }

    local URLS = {
        tails        = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/tails.mp3",
        knuckles     = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/kncukles.mp3",
        eggman       = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/eggman.mp3",
        amy          = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/amy.mp3",
        cream        = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/cream.mp3",
        sally        = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/sally.mp3",
        shadow       = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/shadow.mp3",
        rouge        = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/rouge.mp3",
        blaze        = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/blaze.mp3",
        silver       = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/silver.mp3",
        charmy       = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/charmy.mp3",
        espio        = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/espio.mp3",
        vector       = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/vector.mp3",
        sonic        = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/sonic.mp3",
        supersonic   = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/supersonic.mp3",
        metalsonic   = "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/metal.mp3",
        metalknuckles= "https://raw.githubusercontent.com/Disaster955/TD-LMS/main/metal.mp3",
    }

    local BLOCKED_IDS = {
        ["rbxassetid://105414121158712"]=true, ["rbxassetid://129873804843500"]=true, ["rbxassetid://118295134573230"]=true,
        ["rbxassetid://116334375058596"]=true, ["rbxassetid://122522528782126"]=true, ["rbxassetid://77862321039568"]=true,
        ["rbxassetid://119205672556705"]=true, ["rbxassetid://139366244024539"]=true, ["rbxassetid://137459379624460"]=true,
        ["rbxassetid://76092783336185"]=true,  ["rbxassetid://139281633281602"]=true, ["rbxassetid://140514101401328"]=true,
        ["rbxassetid://71371995187532"]=true,  ["rbxassetid://79783414850131"]=true,  ["rbxassetid://136149668660905"]=true,
        ["rbxassetid://87326829761105"]=true,  ["rbxassetid://121107014646070"]=true, ["rbxassetid://104149909232629"]=true,
        ["rbxassetid://140484222640306"]=true, ["rbxassetid://86517721600549"]=true,
        ["rbxassetid://127850344765337"]=true, ["rbxassetid://138157715381527"]=true, ["rbxassetid://101816882733051"]=true,
    }

    local CUSTOM_NAME = "LMS_Custom"
    local CUSTOM_ATTR = "LMS_CUSTOM_SOUND"

    local function clamp01(x)
        if x < 0 then return 0 end
        if x > 1 then return 1 end
        return x
    end

    local function boostedVolume()
        return clamp01(mainSoundsGroup.Volume + 0.25)
    end

    local function isBlockedCurrent()
        return currentSound and BLOCKED_IDS[currentSound.SoundId] == true
    end

    local function stopCurrentNow()
        if currentSound and currentSound.Playing then
            currentSound:Stop()
        end
    end

    local function loadAsset(url, filename)
        local ok, data = pcall(function()
            return game:HttpGet(url, true)
        end)
        if ok and data then
            pcall(writefile, filename, data)
        end
        if isfile(filename) then
            return getcustomasset(filename)
        end
        return nil
    end

    local function isAliveDisplay(displayObj)
        local blood  = displayObj:FindFirstChild("blood")
        local health = displayObj:FindFirstChild("health")
        return (health and health.Value > 0) or (blood and blood.Value > 0)
    end

    local function getCharacterName(displayObj)
        local stats = displayObj:FindFirstChild("stats")
        local char  = stats and stats:FindFirstChild("character")
        if not char then return nil end
        return tostring(char.Value):lower()
    end

    local function isEligibleCharacter(charName)
        return charName and not IGNORED[charName] and TAKEN[charName] == true
    end

    local function getLmsTarget()
        local target, count = nil, 0
        for _, displayObj in ipairs(displayPlayers:GetChildren()) do
            local charName = getCharacterName(displayObj)
            if isEligibleCharacter(charName) and isAliveDisplay(displayObj) then
                count += 1
                target = displayObj
                if count > 1 then return nil end
            end
        end
        return (count == 1) and target or nil
    end

    local function isOurCustomSound(s)
        return s and s:IsA("Sound")
            and s ~= currentSound
            and (s.Name == CUSTOM_NAME or s:GetAttribute(CUSTOM_ATTR) == true)
    end

    local function getCustomSounds()
        local list = {}
        for _, obj in ipairs(mainSoundsGroup:GetChildren()) do
            if isOurCustomSound(obj) then
                table.insert(list, obj)
            end
        end
        return list
    end

    local function keepOnlyOneCustomSound()
        local list = getCustomSounds()
        local keep = list[1]
        for i = 2, #list do
            pcall(function()
                list[i]:Stop()
                list[i]:Destroy()
            end)
        end
        return keep
    end

    local function getCustomSound()
        return keepOnlyOneCustomSound()
    end

    local savedVolumes = setmetatable({}, { __mode = "k" })

    local function setMuted(sound, shouldMute)
        if not sound or not sound:IsA("Sound") then return end
        if sound == currentSound then return end

        if shouldMute then
            if savedVolumes[sound] == nil then
                savedVolumes[sound] = sound.Volume
            end
            sound.Volume = 0
        else
            local prev = savedVolumes[sound]
            if prev ~= nil then
                sound.Volume = prev
                savedVolumes[sound] = nil
            end
        end
    end

    local function muteFolder(folder, shouldMute)
        if not folder then return end
        for _, obj in ipairs(folder:GetDescendants()) do
            if obj:IsA("Sound") then
                setMuted(obj, shouldMute)
            end
        end
    end

    local function muteBlockedEverywhere(shouldMute)
        for _, obj in ipairs(SoundService:GetDescendants()) do
            if obj:IsA("Sound") and obj ~= currentSound and BLOCKED_IDS[obj.SoundId] then
                setMuted(obj, shouldMute)
            end
        end
    end

    local function applyMute(shouldMute)
        local soundEffects = SoundService:FindFirstChild("soundEffects")
        local envFolder = soundEffects and soundEffects:FindFirstChild("enviromentSoundEffects")
        muteFolder(envFolder, shouldMute)

        local chase = mainSoundsGroup:FindFirstChild("chase")
        setMuted(chase, shouldMute)

        muteBlockedEverywhere(shouldMute)
    end

    local function configure3D(sound)
        sound.RollOffMode = currentSound.RollOffMode
        sound.RollOffMinDistance = currentSound.RollOffMinDistance
        sound.RollOffMaxDistance = currentSound.RollOffMaxDistance
    end

    local ASSET_CACHE = {}
    local ASSET_LOADING = {}

    local function getCachedAssetFor(charName)
        return ASSET_CACHE[charName]
    end

    local ticking = false
    local function tickImmediate() end

    local function preloadManager(maxParallel)
        local queue = {}
        for charName in pairs(URLS) do
            table.insert(queue, charName)
        end

        local running = 0
        local function runNext()
            while running < maxParallel and #queue > 0 do
                local charName = table.remove(queue, 1)
                if not ASSET_CACHE[charName] and not ASSET_LOADING[charName] then
                    local url = URLS[charName]
                    if url then
                        ASSET_LOADING[charName] = true
                        running += 1

                        task.spawn(function()
                            local filename = ("dynamic_%s.mp3"):format(charName)

                            if isfile(filename) then
                                ASSET_CACHE[charName] = getcustomasset(filename)
                            else
                                local asset = loadAsset(url, filename)
                                if asset then
                                    ASSET_CACHE[charName] = asset
                                end
                            end

                            ASSET_LOADING[charName] = nil
                            running -= 1
                            runNext()
                            tickImmediate()
                        end)
                    end
                end
            end
        end

        runNext()
    end

    local blockedReady = false
    local creating = false

    local function destroyCustomAndRestore()
        for _, s in ipairs(getCustomSounds()) do
            pcall(function()
                s:Stop()
                s:Destroy()
            end)
        end
        applyMute(false)
    end

    local function ensureCustomForTarget(targetDisplay)
        if creating then return false end
        creating = true

        local charName = getCharacterName(targetDisplay)
        if not charName or not URLS[charName] then
            creating = false
            return false
        end

        local asset = getCachedAssetFor(charName)
        if not asset then
            creating = false
            return false
        end

        local custom = getCustomSound()
        if custom then
            if custom.SoundId ~= asset then
                custom:Stop()
                custom.SoundId = asset
            end
            custom.Volume = boostedVolume()
            custom.Looped = true
            configure3D(custom)
            if not custom.Playing then
                custom:Play()
            end
        else
            custom = Instance.new("Sound")
            custom.Name = CUSTOM_NAME
            custom:SetAttribute(CUSTOM_ATTR, true)
            custom.SoundId = asset
            custom.Volume = boostedVolume()
            custom.Looped = true
            configure3D(custom)
            custom.Parent = mainSoundsGroup
            custom:Play()
        end

        creating = false
        return true
    end

    local function enforceWhenCustomExists()
        if getCustomSound() then
            applyMute(true)
            stopCurrentNow()
        end
    end

    local function evaluateNow()
        if not isBlockedCurrent() then
            if blockedReady then
                blockedReady = false
                destroyCustomAndRestore()
            end
            return
        end

        blockedReady = true

        if getCustomSound() then
            enforceWhenCustomExists()
            return
        end

        local target = getLmsTarget()
        if not target then
            return
        end

        local created = ensureCustomForTarget(target)
        if created then
            enforceWhenCustomExists()
        end
    end

    function tickImmediate()
        if ticking then return end
        ticking = true
        task.defer(function()
            ticking = false
            evaluateNow()
        end)
    end

    mainSoundsGroup:GetPropertyChangedSignal("Volume"):Connect(function()
        local custom = getCustomSound()
        if custom then
            custom.Volume = boostedVolume()
            applyMute(true)
            stopCurrentNow()
        end
    end)

    currentSound:GetPropertyChangedSignal("SoundId"):Connect(tickImmediate)

    local function bindDisplay(displayObj)
        local stats = displayObj:FindFirstChild("stats")
        if stats then
            local char = stats:FindFirstChild("character")
            if char then
                char:GetPropertyChangedSignal("Value"):Connect(tickImmediate)
            end
        end

        local blood = displayObj:FindFirstChild("blood")
        if blood then
            blood:GetPropertyChangedSignal("Value"):Connect(tickImmediate)
        end

        local health = displayObj:FindFirstChild("health")
        if health then
            health:GetPropertyChangedSignal("Value"):Connect(tickImmediate)
        end
    end

    for _, obj in ipairs(displayPlayers:GetChildren()) do
        bindDisplay(obj)
    end

    displayPlayers.ChildAdded:Connect(function(obj)
        bindDisplay(obj)
        tickImmediate()
    end)

    task.spawn(function()
        while true do
            evaluateNow()
            task.wait(0.02)
        end
    end)

    blockedReady = isBlockedCurrent()
    keepOnlyOneCustomSound()
    preloadManager(10)
    tickImmediate()
end)

btn5.MouseButton1Click:Connect(function()
    local Players = game:GetService("Players")

    local player = Players.LocalPlayer
    local TARGET = 40

    local bag: { RBXScriptConnection } = {}
    local dead = false

    local function drop()
        if dead then return end
        dead = true

        for i = #bag, 1, -1 do
            local c = bag[i]
            if c.Connected then
                c:Disconnect()
            end
            bag[i] = nil
        end

        script:Destroy()
    end

    local function lock(h: Humanoid)
        if h.WalkSpeed ~= TARGET then
            h.WalkSpeed = TARGET
        end

        bag[#bag + 1] = h:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if h.WalkSpeed ~= TARGET then
                h.WalkSpeed = TARGET
            end
        end)

        bag[#bag + 1] = h.Died:Connect(drop)
    end

    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid") :: Humanoid

    lock(humanoid)

    bag[#bag + 1] = character.AncestryChanged:Connect(function(_, parent)
        if parent == nil then
            drop()
        end
    end)
end)
